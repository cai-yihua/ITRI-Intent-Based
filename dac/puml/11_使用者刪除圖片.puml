@startuml Role Definition
!pragma teoz true

' Title
title 使用者刪除圖片

' ------- 全域樣式 -------
skinparam backgroundColor #fefefe
skinparam roundcorner 15
skinparam DefaultFontSize 14
skinparam DefaultFontName Arial

' ------- Actor -------
actor FE    as "FrontEnd [Actor]"

' ------- Module -------
' ─ Conversation Management ─
box "Conversation Mgt Module [Module]" #LightGreen
	participant Conv_IM as "ImageManager [Actor]"
end box

' ─ Metadata Management ─
box "Metadata Mgt Module [Module]" #LightGreen
	participant Meta_IM as "ImageManager [Actor]"
end box


' STEP 0: FE 刪除圖片
group step 0: FE 刪除圖片
autonumber 0.0
FE -> Conv_IM: /delete_image\n{image_uid}
activate Conv_IM
end group


' STEP 1: 取得 image metadata
group step 1: 取得 image metadata
autonumber 1.0
Conv_IM -> Meta_IM: /get_image_metadata\n{image_uid}
activate Meta_IM
Meta_IM -> Meta_IM: 找對應 image metadata\n取得 image_path
Meta_IM --> Conv_IM: 取得成功 {image_path}
deactivate Meta_IM
end group


' STEP 2: 刪除圖片檔案
group step 2: 刪除圖片檔案
autonumber 2.0
Conv_IM -> Conv_IM: 刪除 media/images/{conversation_uid}/{image_uid}.png
end group


' STEP 3: 刪除 image metadata
group step 3: 刪除 image metadata
autonumber 3.0
Conv_IM -> Meta_IM: /delete_image_metadata\n{image_uid}
activate Meta_IM
Meta_IM -> Meta_IM: 刪除 image metadata
Meta_IM --> Conv_IM: 刪除成功
deactivate Meta_IM
end group


autonumber 4
Conv_IM --> FE: 刪除成功
deactivate Conv_IM

@enduml
